void buscarEstudianteMenu(){
    char documento[20];
    cout << "Documento del estudiante: ";
    cin.getline(documento, 20);

    for (int p = 0; p < universidad.programasCount; p++){
        Programa &prog = universidad.programas[p];
        for (int e = 0; e < prog.estudiantesCount; e++){
            Estudiante &est = prog.estudiantes[e];
            if (strcmp(est.documento, documento) == 0){
                cout << "\n===== Estudiante encontrado =====" << endl;
                cout << "ID: " << est.id << endl;
                cout << "Nombre: " << est.nombre << endl;
                cout << "Documento: " << est.documento << endl;
                cout << "Telefono: " << est.telefono << endl;
                cout << "Programa: " << prog.nombre << " (Codigo " << prog.codigo << ")" << endl;

                cout << "Materias matriculadas:" << endl;
                float sumaDefinitivas = 0;
                for (int m = 0; m < est.matriculasCount; m++){
                    Matricula &mat = est.matriculas[m];
                    cout << "  " << mat.codigoMateria << " - " << mat.nombreMateria
                         << " - Definitiva: " << mat.definitiva << endl;
                    sumaDefinitivas += mat.definitiva;
                }

                if (est.matriculasCount > 0){
                    cout << "Promedio general: " << fixed << setprecision(2)
                         << (sumaDefinitivas / est.matriculasCount) << endl;
                } else {
                    cout << "El estudiante aun no tiene materias matriculadas." << endl;
                }
                return;
            }
        }
    }
    cout << "No se encontro un estudiante con el documento " << documento << endl;
}

