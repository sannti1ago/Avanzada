using namespace std;

struct Fecha{
    char anio[5];
    char mes[3];
    char dia[3];
};

struct Matricula{
    int id;
    char codigoMateria[10];
    char nombreMateria[40];
    float notas[3];
    float definitiva;
    Fecha fecha;
};

struct Estudiante{
    int id;
    char nombre[50];
    char documento[20];
    char telefono[20];
    Matricula *matriculas;
    int matriculasCount;
};

struct Programa{
    int codigo;
    char nombre[50];
    Estudiante *estudiantes;
    int estudiantesCount;
};

struct Universidad{
    Programa *programas;
    int programasCount;
};

struct ProgramaDisco{
    int codigo;
    char nombre[50];
};

struct EstudianteDisco{
    int idPrograma;
    int id;
    char nombre[50];
    char documento[20];
    char telefono[20];
};

struct MatriculaDisco{
    int idEstudiante;
    int id;
    char codigoMateria[10];
    char nombreMateria[40];
    float notas[3];
    float definitiva;
    Fecha fecha;
};

Universidad universidad = { nullptr, 0 };

Programa* buscarPrograma(int codigo){
    for (int i = 0; i < universidad.programasCount; i++){
        if (universidad.programas[i].codigo == codigo)
            return &universidad.programas[i];
    }
    return nullptr;
}

Estudiante* buscarEstudiantePorDocumento(const char documento[]){
    for (int p = 0; p < universidad.programasCount; p++){
        Programa &prog = universidad.programas[p];
        for (int e = 0; e < prog.estudiantesCount; e++){
            if (strcmp(prog.estudiantes[e].documento, documento) == 0)
                return &prog.estudiantes[e];
        }
    }
    return nullptr;
}

Estudiante* buscarEstudiantePorId(int id){
    for (int p = 0; p < universidad.programasCount; p++){
        Programa &prog = universidad.programas[p];
        for (int e = 0; e < prog.estudiantesCount; e++){
            if (prog.estudiantes[e].id == id)
                return &prog.estudiantes[e];
        }
    }
    return nullptr;
}

int generarIdEstudiante(){
    int id;
    bool repetido;
    do{
        id = rand() % 90000 + 10000;
        repetido = false;
        for (int p = 0; p < universidad.programasCount && !repetido; p++){
            for (int e = 0; e < universidad.programas[p].estudiantesCount; e++){
                if (universidad.programas[p].estudiantes[e].id == id){
                    repetido = true;
                    break;
                }
            }
        }
    } while (repetido);
    return id;
}

int generarIdMatricula(){
    int id;
    bool repetido;
    do{
        id = rand() % 90000 + 10000;
        repetido = false;
        for (int p = 0; p < universidad.programasCount && !repetido; p++){
            for (int e = 0; e < universidad.programas[p].estudiantesCount && !repetido; e++){
                Estudiante &est = universidad.programas[p].estudiantes[e];
                for (int m = 0; m < est.matriculasCount; m++){
                    if (est.matriculas[m].id == id){
                        repetido = true;
                        break;
                    }
                }
            }
        }
    } while (repetido);
    return id;
}

void agregarPrograma(int codigo, const char nombre[]){
    if (buscarPrograma(codigo) != nullptr){
        cout << "El programa con codigo " << codigo << " ya existe." << endl;
        return;
    }

    Programa *nuevoArreglo = new Programa[universidad.programasCount + 1];
    for (int i = 0; i < universidad.programasCount; i++){
        nuevoArreglo[i] = universidad.programas[i];
    }

    nuevoArreglo[universidad.programasCount].codigo = codigo;
    strcpy(nuevoArreglo[universidad.programasCount].nombre, nombre);
    nuevoArreglo[universidad.programasCount].estudiantes = nullptr;
    nuevoArreglo[universidad.programasCount].estudiantesCount = 0;

    delete[] universidad.programas;
    universidad.programas = nuevoArreglo;
    universidad.programasCount++;

    cout << "Programa creado correctamente. Codigo: " << codigo << endl;
}

void insertarEstudiante(Programa *programa, int id, const char nombre[], const char documento[], const char telefono[]){
    Estudiante *nuevoArreglo = new Estudiante[programa->estudiantesCount + 1];
    for (int i = 0; i < programa->estudiantesCount; i++){
        nuevoArreglo[i] = programa->estudiantes[i];
    }

    nuevoArreglo[programa->estudiantesCount].id = id;
    strcpy(nuevoArreglo[programa->estudiantesCount].nombre, nombre);
    strcpy(nuevoArreglo[programa->estudiantesCount].documento, documento);
    strcpy(nuevoArreglo[programa->estudiantesCount].telefono, telefono);
    nuevoArreglo[programa->estudiantesCount].matriculas = nullptr;
    nuevoArreglo[programa->estudiantesCount].matriculasCount = 0;

    delete[] programa->estudiantes;
    programa->estudiantes = nuevoArreglo;
    programa->estudiantesCount++;
}

void agregarEstudiante(int codigoPrograma, const char nombre[], const char documento[], const char telefono[]){
    Programa *programa = buscarPrograma(codigoPrograma);
    if (programa == nullptr){
        cout << "No existe un programa con codigo " << codigoPrograma << endl;
        return;
    }
    if (buscarEstudiantePorDocumento(documento) != nullptr){
        cout << "Ya existe un estudiante con el documento " << documento << endl;
        return;
    }

    int nuevoId = generarIdEstudiante();
    insertarEstudiante(programa, nuevoId, nombre, documento, telefono);

    cout << "Estudiante creado correctamente. ID asignado: " << nuevoId << endl;
}

void insertarMatricula(Estudiante *estudiante, int id, const char codigoMateria[], const char nombreMateria[], Fecha fecha, float notas[3], float definitiva){
    Matricula *nuevoArreglo = new Matricula[estudiante->matriculasCount + 1];
    for (int i = 0; i < estudiante->matriculasCount; i++){
        nuevoArreglo[i] = estudiante->matriculas[i];
    }

    nuevoArreglo[estudiante->matriculasCount].id = id;
    strcpy(nuevoArreglo[estudiante->matriculasCount].codigoMateria, codigoMateria);
    strcpy(nuevoArreglo[estudiante->matriculasCount].nombreMateria, nombreMateria);
    for (int n = 0; n < 3; n++) nuevoArreglo[estudiante->matriculasCount].notas[n] = notas[n];
    nuevoArreglo[estudiante->matriculasCount].definitiva = definitiva;
    nuevoArreglo[estudiante->matriculasCount].fecha = fecha;

    delete[] estudiante->matriculas;
    estudiante->matriculas = nuevoArreglo;
    estudiante->matriculasCount++;
}

void agregarMatricula(const char documentoEstudiante[], const char codigoMateria[], const char nombreMateria[], Fecha fecha, float notas[3]){
    Estudiante *estudiante = buscarEstudiantePorDocumento(documentoEstudiante);
    if (estudiante == nullptr){
        cout << "No existe un estudiante con el documento " << documentoEstudiante << endl;
        return;
    }

    for (int m = 0; m < estudiante->matriculasCount; m++){
        if (strcmp(estudiante->matriculas[m].codigoMateria, codigoMateria) == 0){
            cout << "La materia " << codigoMateria << " ya esta matriculada para este estudiante." << endl;
            return;
        }
    }

    for (int n = 0; n < 3; n++){
        if (notas[n] < 0.0f || notas[n] > 5.0f){
            cout << "Nota invalida: " << notas[n] << ". Debe estar entre 0.0 y 5.0." << endl;
            return;
        }
    }

    int nuevoId = generarIdMatricula();
    float definitiva = (notas[0] + notas[1] + notas[2]) / 3.0f;

    insertarMatricula(estudiante, nuevoId, codigoMateria, nombreMateria, fecha, notas, definitiva);

    cout << "Matricula registrada correctamente. ID asignado: " << nuevoId << endl;
}

void cargaMasivaEstudiantes(){
    ifstream archivo("estudiantes.csv");
    if (!archivo.is_open()){
        cout << "No se pudo abrir el archivo estudiantes.csv" << endl;
        return;
    }

    char linea[200];
    int importados = 0;

    while (archivo.getline(linea, 200)){
        if (strlen(linea) == 0) continue;

        char *token = strtok(linea, ",");
        int codigoPrograma = atoi(token);
        token = strtok(nullptr, ",");
        char nombrePrograma[50];
        strcpy(nombrePrograma, token);
        token = strtok(nullptr, ",");
        int idEstudiante = atoi(token);
        token = strtok(nullptr, ",");
        char nombre[50];
        strcpy(nombre, token);
        token = strtok(nullptr, ",");
        char documento[20];
        strcpy(documento, token);
        token = strtok(nullptr, ",");
        char telefono[20];
        strcpy(telefono, token);

        Programa *programa = buscarPrograma(codigoPrograma);
        if (programa == nullptr){
            agregarPrograma(codigoPrograma, nombrePrograma);
            programa = buscarPrograma(codigoPrograma);
        }

        if (buscarEstudiantePorDocumento(documento) != nullptr){
            cout << "Documento " << documento << " ya existe, se omite." << endl;
            continue;
        }

        insertarEstudiante(programa, idEstudiante, nombre, documento, telefono);
        importados++;
    }

    archivo.close();
    cout << "Carga masiva completada. Estudiantes importados: " << importados << endl;
}

void cargarUniversidad(){
    ifstream archivoProgramas("programas.dat", ios::binary);
    if (archivoProgramas.is_open()){
        ProgramaDisco pd;
        while (archivoProgramas.read((char*)&pd, sizeof(pd))){
            agregarPrograma(pd.codigo, pd.nombre);
        }
        archivoProgramas.close();
    }

    ifstream archivoEstudiantes("estudiantes.dat", ios::binary);
    if (archivoEstudiantes.is_open()){
        EstudianteDisco ed;
        while (archivoEstudiantes.read((char*)&ed, sizeof(ed))){
            Programa *programa = buscarPrograma(ed.idPrograma);
            if (programa != nullptr){
                insertarEstudiante(programa, ed.id, ed.nombre, ed.documento, ed.telefono);
            }
        }
        archivoEstudiantes.close();
    }

    ifstream archivoMatriculas("matriculas.dat", ios::binary);
    if (archivoMatriculas.is_open()){
        MatriculaDisco md;
        while (archivoMatriculas.read((char*)&md, sizeof(md))){
            Estudiante *estudiante = buscarEstudiantePorId(md.idEstudiante);
            if (estudiante != nullptr){
                insertarMatricula(estudiante, md.id, md.codigoMateria, md.nombreMateria, md.fecha, md.notas, md.definitiva);
            }
        }
        archivoMatriculas.close();
    }
}

void guardarUniversidad(){
    remove("programas.dat");
    remove("estudiantes.dat");
    remove("matriculas.dat");

    ofstream archivoProgramas("programas.dat", ios::binary);
    ofstream archivoEstudiantes("estudiantes.dat", ios::binary);
    ofstream archivoMatriculas("matriculas.dat", ios::binary);

    for (int p = 0; p < universidad.programasCount; p++){
        Programa &prog = universidad.programas[p];

        ProgramaDisco pd;
        pd.codigo = prog.codigo;
        strcpy(pd.nombre, prog.nombre);
        archivoProgramas.write((char*)&pd, sizeof(pd));

        for (int e = 0; e < prog.estudiantesCount; e++){
            Estudiante &est = prog.estudiantes[e];

            EstudianteDisco ed;
            ed.idPrograma = prog.codigo;
            ed.id = est.id;
            strcpy(ed.nombre, est.nombre);
            strcpy(ed.documento, est.documento);
            strcpy(ed.telefono, est.telefono);
            archivoEstudiantes.write((char*)&ed, sizeof(ed));

            for (int m = 0; m < est.matriculasCount; m++){
                Matricula &mat = est.matriculas[m];

                MatriculaDisco md;
                md.idEstudiante = est.id;
                md.id = mat.id;
                strcpy(md.codigoMateria, mat.codigoMateria);
                strcpy(md.nombreMateria, mat.nombreMateria);
                for (int n = 0; n < 3; n++) md.notas[n] = mat.notas[n];
                md.definitiva = mat.definitiva;
                md.fecha = mat.fecha;
                archivoMatriculas.write((char*)&md, sizeof(md));
            }
        }
    }

    archivoProgramas.close();
    archivoEstudiantes.close();
    archivoMatriculas.close();
    cout << "Informacion guardada correctamente." << endl;
}

void liberarMemoria(){
    for (int p = 0; p < universidad.programasCount; p++){
        Programa &prog = universidad.programas[p];
        for (int e = 0; e < prog.estudiantesCount; e++){
            delete[] prog.estudiantes[e].matriculas;
        }
        delete[] prog.estudiantes;
    }
    delete[] universidad.programas;
    universidad.programas = nullptr;
    universidad.programasCount = 0;
}

