void generarReporteMatriculas(){
    ofstream archivo("matriculas.txt");
    archivo << fixed << setprecision(2);
    for (int p = 0; p < universidad.programasCount; p++){
        Programa &prog = universidad.programas[p];
        for (int e = 0; e < prog.estudiantesCount; e++){
            Estudiante &est = prog.estudiantes[e];
            for (int m = 0; m < est.matriculasCount; m++){
                Matricula &mat = est.matriculas[m];
                archivo << prog.nombre << "," << est.nombre << "," << mat.codigoMateria << ","
                        << mat.nombreMateria << "," << mat.definitiva << endl;
            }
        }
    }
    archivo.close();
    cout << "Reporte generado: matriculas.txt" << endl;
}

void generarReportePromedios(){
    ofstream archivo("reporte_promedios.txt");
    archivo << "Programa,Documento,Estudiante,Promedio" << endl;

    for (int p = 0; p < universidad.programasCount; p++){
        Programa &prog = universidad.programas[p];
        for (int e = 0; e < prog.estudiantesCount; e++){
            Estudiante &est = prog.estudiantes[e];
            if (est.matriculasCount == 0) continue;

            float suma = 0;
            for (int m = 0; m < est.matriculasCount; m++){
                suma += est.matriculas[m].definitiva;
            }
            float promedio = suma / est.matriculasCount;

            archivo << prog.nombre << "," << est.documento << "," << est.nombre << ","
                    << fixed << setprecision(2) << promedio << endl;
        }
    }
    archivo.close();
    cout << "Reporte generado: reporte_promedios.txt" << endl;
}

